{
  "$note": [
    "双来源搜索两端共用场景清单（设计文档《Kiwi-Buyer-双来源搜索设计文档-v1.1》§12 验收标准 + §7/§8 状态规则）。",
    "用途：Hermes 插件会话与 WorkBuddy 采购专家会话的对话级验收清单；本文件由",
    "tests/buyer-network-search.test.ts 做结构与规则校验（覆盖完整、不得在非 completed+no_match",
    "时报『无供应商』、不得在无证据时报『已发送』『已报价』）。",
    "network：Kiwi Network 一侧的查询状态（SOURCE_QUERY_STATUSES）；null = 该场景不涉及。",
    "internet：互联网电商一侧由宿主掌握，取值 completed/partial/failed/timeout/unavailable（工具不可用或未授权）/not_searched（用户限定来源或能力不可用）。",
    "network_match：exact / weak / none（弱匹配必须明确差异，不得表述为已找到符合要求的供应商）。",
    "must_not_claim：该场景下禁止出现的结论（对话实测时逐条核对）。"
  ],
  "cases": [
    {
      "id": "S01",
      "design_ref": "S01",
      "title": "默认采购搜索",
      "layer": "search",
      "network": "completed",
      "network_result_state": "has_candidates",
      "network_match": "exact",
      "internet": "completed",
      "send_evidence": null,
      "merchant_replied_with_price": null,
      "must_not_claim": [],
      "expectation": "发起两个来源查询，回复明确区分来源。"
    },
    {
      "id": "S02",
      "design_ref": "S02",
      "title": "用户仅查 Network",
      "layer": "search",
      "network": "completed",
      "network_result_state": "has_candidates",
      "network_match": "exact",
      "internet": "not_searched",
      "send_evidence": null,
      "merchant_replied_with_price": null,
      "must_not_claim": ["已搜索互联网", "两边均已搜索完成"],
      "expectation": "仅搜索指定来源，不暗示已经搜索互联网。"
    },
    {
      "id": "S03",
      "design_ref": "S03",
