{
  "name": "@harrylabsj/kiwi-npm-shipping-stage",
  "version": "0.12.17",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@12.2.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@earendil-works/chord": "1.2.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@simplewebauthn/server": "14.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  }
}
