{
  "name": "@harrylabsj/kiwi-main-cloud-internal-candidate",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "main": "app/cloud/main.js",
  "scripts": {
    "preinstall": "node scripts/check-install-toolchain.mjs",
    "start": "node app/cloud/main.js"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=12.0.2 <13"
  },
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@simplewebauthn/server": "14.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1",
    "@earendil-works/pi-durable": "1.0.2",
    "typebox": "1.3.27"
  }
}
