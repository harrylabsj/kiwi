{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiwi:merchant-cloud:0.1.2:runtime-binding-claims",
  "title": "Kiwi Merchant Cloud runtime-binding-claims 0.1.2",
  "description": "新增内部设计契约。不是WorkBuddy官方接口；不构成平台成功、密码学或生产就绪证明。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.2"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$"
    },
    "binding_version": {
      "type": "integer",
      "minimum": 1
    },
    "merchant_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$"
    },
    "workload_ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,95}$"
    },
    "runtime_origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "a2a_endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "card_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "key_thumbprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "service_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "a2a-runtime"
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    }
  },
  "required": [
    "schema_version",
    "binding_id",
    "binding_version",
    "merchant_id",
    "agent_id",
    "workload_ref",
    "runtime_origin",
    "a2a_endpoint",
    "card_url",
    "key_id",
    "key_thumbprint",
    "service_epoch",
    "issued_at",
    "expires_at",
    "issuer",
    "scope",
    "status"
  ]
}
