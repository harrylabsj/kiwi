{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kiwi:rfq-workbench:0.1.0:release-request",
  "title": "ReleaseRequest",
  "description": "候选开发契约；记录结构不等于模型工具输入。权限、引用一致性与跨字段约束由服务端校验。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "merchant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "quote_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "quote_revision": {
      "type": "integer",
      "minimum": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recipient_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "quote_content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "template_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fact_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING_APPROVAL",
        "APPROVED",
        "EXPORTED",
        "REJECTED",
        "SUPERSEDED",
        "EXPIRED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "public_projection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "merchant_id",
    "release_id",
    "candidate_id",
    "quote_id",
    "quote_revision",
    "principal_id",
    "recipient_ref",
    "quote_content_digest",
    "artifact_id",
    "artifact_sha256",
    "template_version",
    "policy_version",
    "fact_fingerprint",
    "created_at",
    "expires_at",
    "status",
    "synthetic",
    "public_projection_digest"
  ]
}
