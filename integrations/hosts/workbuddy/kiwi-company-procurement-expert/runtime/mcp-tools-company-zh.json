[{"description":"发现候选供应商，并按需跨商家搜索商品。只读。在 Kiwi Network 内全球搜索，旧版 region 参数不参与筛选，到货时间另行确认。只覆盖 Kiwi Network（Kiwi 网络内商家）：互联网电商商品不在本工具范围内，须由宿主自身的检索/取页工具完成，不得用本结果冒充外部平台信息。内部语义：Merchant routing + UCP Catalog orchestration + trust/freshness。返回 network_search 说明本次 Network 查询的真实状态（status: completed/partial/timeout/error/not_searched；result_state: has_candidates/no_match/undetermined）——只有 completed + no_match 才能说「本次没有匹配」；超时、失败、部分完成、未搜索都不得表述为「没有供应商」。结果中 inquiry_available=true 的商家可实时询价（可进入 kiwi_request_quotes）；inquiry_available=false 且 source_kind=merchant_declared 的商家仅有第 0 版公开资料（资料可查，含命中商品名/更新时间/店铺入口），不可发起询价。products 是商家既有资料投影（basis=merchant_listed；price.kind=merchant_listed_price 为商家资料价，无价则 to_be_quoted），未经本次询价确认，不得当作报价、库存或交期承诺。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"category":{"type":"string"},"query":{"minLength":1,"type":"string"},"region":{"deprecated":true,"description":"此参数已弃用。Kiwi Network 在全球范围内搜索，到货时间另行确认。","type":"string"}},"required":["query"],"type":"object"},"name":"kiwi_search"},{"description":"按采购事项和商家商品绑定向一家 Kiwi 商家询价。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approval_id":{"maxLength":256,"minLength":1,"type":"string"},"idempotency_key":{"maxLength":256,"minLength":1,"type":"string"},"intent":{"additionalProperties":false,"properties":{"intent_id":{"maxLength":256,"minLength":1,"type":"string"},"intent_type":{"enum":["inquiry","procurement","purchase"],"type":"string"},"items":{"items":{"additionalProperties":false,"properties":{"quantity":{"additionalProperties":false,"properties":{"unit":{"maxLength":256,"minLength":1,"type":"string"},"value":{"maximum":9007199254740991,"minimum":1,"type":"integer"}},"required":["value","unit"],"type":"object"},"query":{"maxLength":256,"minLength":1,"type":"string"},"sku":{"maxLength":256,"minLength":1,"type":"string"}},"required":["query","sku","quantity"],"type":"object"},"maxItems":1,"minItems":1,"type":"array"}},"required":["intent_id","intent_type","items"],"type":"object"},"merchant_ids":{"items":{"maxLength":256,"minLength":1,"type":"string"},"maxItems":1,"minItems":1,"type":"array"},"procurement_ref":{"additionalProperties":false,"properties":{"case_id":{"maxLength":256,"minLength":1,"type":"string"},"replaces_source_id":{"maxLength":256,"minLength":1,"type":"string"},"revision":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"source_binding_id":{"maxLength":256,"minLength":1,"type":"string"}},"required":["case_id","revision","source_binding_id"],"type":"object"}},"required":["intent","merchant_ids","idempotency_key","procurement_ref"],"type":"object"},"name":"kiwi_request_quotes"},{"description":"读取任务状态、报价、部分失败、待审批与过期信息。统一 status/resume 读取面；替代把 offer/pending 状态放在插件内存。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"task_id":{"minLength":1,"type":"string"}},"required":["task_id"],"type":"object"},"name":"kiwi_get_task"},{"description":"针对明确的 Kiwi 报价澄清或发送明确含税口径的目标单价。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"approval_id":{"maxLength":256,"minLength":1,"type":"string"},"candidate_id":{"maxLength":256,"minLength":1,"type":"string"},"comparison_ref":{"additionalProperties":false,"properties":{"comparison_id":{"maxLength":256,"minLength":1,"type":"string"},"revision":{"maximum":9007199254740991,"minimum":1,"type":"integer"}},"required":["comparison_id","revision"],"type":"object"},"expected_offer_digest":{"maxLength":256,"minLength":1,"type":"string"},"questions":{"items":{"additionalProperties":false,"properties":{"field":{"maxLength":256,"minLength":1,"type":"string"},"reason":{"maxLength":2000,"minLength":1,"type":"string"}},"required":["field"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"request_id":{"maxLength":256,"minLength":1,"type":"string"},"task_id":{"maxLength":256,"minLength":1,"type":"string"},"target_unit_price":{"additionalProperties":false,"properties":{"amount_minor":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"basis":{"enum":["net","gross"],"type":"string"},"currency":{"enum":["CNY"],"type":"string"}},"required":["currency","amount_minor","basis"],"type":"object"},"action":{"type":"string","enum":["clarification","counter_offer"]}},"required":["task_id","candidate_id","expected_offer_digest","comparison_ref","request_id","action"],"additionalProperties":false},"name":"kiwi_negotiate"},{"description":"请求确认并接受非绑定协议。要求有效 approval_id + candidate_id；输出稳定 agreement_id。DelegationPolicy=ask 时若缺审批会返回 approval_required（含持久 approval_id），宿主完成人工审批后携 approval_id 重试。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approval_id":{"minLength":1,"type":"string"},"candidate_id":{"minLength":1,"type":"string"},"task_id":{"minLength":1,"type":"string"}},"required":["task_id","candidate_id"],"type":"object"},"name":"kiwi_accept_agreement"},{"description":"读取最终协议、provenance 与审计摘要。只读；Agreement retrieval + digest + audit summary。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"agreement_id":{"minLength":1,"type":"string"}},"required":["agreement_id"],"type":"object"},"name":"kiwi_get_agreement"},{"description":"生成交易/PO/联系路径。Agreement → UCP Checkout / merchant transaction endpoint。合法 destination_type：ucp_checkout | ucp_order | external_checkout_url | merchant_checkout_session | platform_deep_link | buyer_erp_request | procurement_request | purchase_order_draft | quote_document | merchant_contact | sales_handoff。external_checkout_url 与 platform_deep_link 必须带 url（商家店铺结算页用 external_checkout_url + 商家 handoff URL）；ucp_checkout / ucp_order / merchant_checkout_session 是 opaque 会话引用，不得带 url。ASK 时缺审批返回结构化 approval_required（含 approval_id），宿主 kiwi_approve 后携 id 重试。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"agreement_id":{"minLength":1,"type":"string"},"approval_id":{"minLength":1,"type":"string"},"destination_type":{"minLength":1,"type":"string"},"url":{"type":"string"}},"required":["agreement_id","destination_type"],"type":"object"},"name":"kiwi_handoff"},{"description":"批准一个持久审批（ASK 门）。宿主在向用户呈现非绑定协议/交接摘要并获得确认后调用；随后携 approval_id 重试 kiwi_accept_agreement / kiwi_handoff。写操作，受宿主审批系统二次拦截。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approval_id":{"minLength":1,"type":"string"},"note":{"type":"string"}},"required":["approval_id"],"type":"object"},"name":"kiwi_approve"},{"description":"拒绝一个持久审批（deny 优先路径）。拒绝后同一 approval_id 无法再批准或形成协议/交接。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approval_id":{"minLength":1,"type":"string"},"reason":{"type":"string"}},"required":["approval_id"],"type":"object"},"name":"kiwi_reject"},{"description":"显式关注一个商家（拉取式订阅）。仅买家主动调用：搜索、浏览、查看资料或发起询价都不构成订阅，不得因这些行为代替买家关注。关注后买家可用 kiwi_get_follow_updates 主动查看该商家的公开动态；商家无法向关注者推送消息。需要 Kiwi 目录登录态（未配置时返回登录引导）。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"category":{"description":"可选：只关心该类目的公开动态","type":"string"},"consent_version":{"description":"可选：买家同意的订阅条款版本","type":"string"},"merchant_id":{"minLength":1,"type":"string"}},"required":["merchant_id"],"type":"object"},"name":"kiwi_follow_merchant"},{"description":"取消关注一个商家（幂等）。仅买家主动调用；取消后该商家不再出现在关注列表，也不再展示其公开动态更新。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"merchant_id":{"minLength":1,"type":"string"}},"required":["merchant_id"],"type":"object"},"name":"kiwi_unfollow_merchant"},{"description":"列出买家当前活跃关注的商家（关注管理面）。只读；需要 Kiwi 目录登录态（未配置时返回登录引导）。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{},"type":"object"},"name":"kiwi_list_follows"},{"description":"查看买家关注的商家有什么公开更新。仅响应买家主动询问（如“我关注的商家有什么新动态”）时调用：按水位增量返回商家公开动态（product_added / product_updated / faq_updated / service_notice / publication_withdrawn，仅公开字段），处理成功后下次用 watermarks 确认各商家的 last_seen_at；未确认的目录更新可重读。拉取式订阅：商家无法向买家推送消息，本工具也不代表买家接收任何商家私信。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"watermarks":{"type":"object","maxProperties":500,"additionalProperties":{"type":"string"}}},"type":"object"},"name":"kiwi_get_follow_updates"},{"description":"建立或修订采购事项、登记来源证据或记录外部决定。","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"lines":{"items":{"additionalProperties":false,"properties":{"input_line_id":{"maxLength":256,"minLength":1,"type":"string"},"raw":{"maxLength":2000,"minLength":1,"type":"string"}},"required":["input_line_id","raw"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"},"request_id":{"maxLength":256,"minLength":1,"type":"string"},"basis":{"additionalProperties":false,"properties":{"budget":{"additionalProperties":false,"properties":{"amount_minor":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"hardness":{"enum":["hard","soft"],"type":"string"},"scope":{"enum":["total","unit"],"type":"string"}},"required":["amount_minor","hardness","scope"],"type":"object"},"buyer_item_key":{"maxLength":256,"minLength":1,"type":"string"},"channels":{"items":{"enum":["kiwi","ecommerce"],"type":"string"},"maxItems":2,"minItems":1,"type":"array","uniqueItems":true},"company":{"maxLength":256,"minLength":1,"type":"string"},"delivery_before":{"maxLength":40,"minLength":20,"type":"string"},"description":{"maxLength":2000,"minLength":1,"type":"string"},"destination":{"maxLength":256,"minLength":1,"type":"string"},"minimum_suppliers":{"maximum":20,"minimum":1,"type":"integer"},"model":{"maxLength":256,"minLength":1,"type":