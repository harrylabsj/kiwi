[{"description":"Discover candidate suppliers and search products across merchants on demand. Read-only. Search is global within the Kiwi Network, the legacy region parameter is ignored, and delivery timing is confirmed separately. Covers the Kiwi Network (in-network merchants) only: internet e-commerce listings are out of scope and must be retrieved with the host's own web tools; never present this result as external platform data. Internals: merchant routing + UCP Catalog orchestration + trust/freshness. The returned network_search reports the true state of this Network query (status: completed/partial/timeout/error/not_searched; result_state: has_candidates/no_match/undetermined) - only completed + no_match may be phrased as 'no match this time'; timeouts, failures, partial completion, or not-searched must never be reported as 'no suppliers available'. Merchants with inquiry_available=true support live quote requests (proceed to kiwi_request_quotes); merchants with inquiry_available=false and source_kind=merchant_declared only have their v0 public profile (browsable: product names, updated-at, storefront link) and cannot be queried for quotes. products is a projection of the merchant's existing profile (basis=merchant_listed; price.kind=merchant_listed_price means the merchant's listed price, absent means to_be_quoted) - never present it as a confirmed quote, stock, or lead-time commitment.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"category":{"type":"string"},"query":{"minLength":1,"type":"string"},"region":{"deprecated":true,"description":"Ignored. Kiwi Network search is global. Confirm delivery timing separately.","type":"string"}},"required":["query"],"type":"object"},"name":"kiwi_search"},{"description":"Send a single-merchant RFQ bound to the current case and product.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approval_id":{"maxLength":256,"minLength":1,"type":"string"},"idempotency_key":{"maxLength":256,"minLength":1,"type":"string"},"intent":{"additionalProperties":false,"properties":{"intent_id":{"maxLength":256,"minLength":1,"type":"string"},"intent_type":{"enum":["inquiry","procurement","purchase"],"type":"string"},"items":{"items":{"additionalProperties":false,"properties":{"quantity":{"additionalProperties":false,"properties":{"unit":{"maxLength":256,"minLength":1,"type":"string"},"value":{"maximum":9007199254740991,"minimum":1,"type":"integer"}},"required":["value","unit"],"type":"object"},"query":{"maxLength":256,"minLength":1,"type":"string"},"sku":{"maxLength":256,"minLength":1,"type":"string"}},"required":["query","sku","quantity"],"type":"object"},"maxItems":1,"minItems":1,"type":"array"}},"required":["intent_id","intent_type","items"],"type":"object"},"merchant_ids":{"items":{"maxLength":256,"minLength":1,"type":"string"},"maxItems":1,"minItems":1,"type":"array"},"procurement_ref":{"additionalProperties":false,"properties":{"case_id":{"maxLength":256,"minLength":1,"type":"string"},"replaces_source_id":{"maxLength":256,"minLength":1,"type":"string"},"revision":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"source_binding_id":{"maxLength":256,"minLength":1,"type":"string"}},"required":["case_id","revision","source_binding_id"],"type":"object"}},"required":["intent","merchant_ids","idempotency_key","procurement_ref"],"type":"object"},"name":"kiwi_request_quotes"},{"description":"Read task status, quotes, partial failures, pending approvals, and expiry info. Unified status/resume read surface; replaces keeping offer/pending state in plugin memory.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"task_id":{"minLength":1,"type":"string"}},"required":["task_id"],"type":"object"},"name":"kiwi_get_task"},{"description":"Clarify a verified Kiwi quote or propose an explicit unit price with its tax basis.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"approval_id":{"maxLength":256,"minLength":1,"type":"string"},"candidate_id":{"maxLength":256,"minLength":1,"type":"string"},"comparison_ref":{"additionalProperties":false,"properties":{"comparison_id":{"maxLength":256,"minLength":1,"type":"string"},"revision":{"maximum":9007199254740991,"minimum":1,"type":"integer"}},"required":["comparison_id","revision"],"type":"object"},"expected_offer_digest":{"maxLength":256,"minLength":1,"type":"string"},"questions":{"items":{"additionalProperties":false,"properties":{"field":{"maxLength":256,"minLength":1,"type":"string"},"reason":{"maxLength":2000,"minLength":1,"type":"string"}},"required":["field"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"request_id":{"maxLength":256,"minLength":1,"type":"string"},"task_id":{"maxLength":256,"minLength":1,"type":"string"},"target_unit_price":{"additionalProperties":false,"properties":{"amount_minor":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"basis":{"enum":["net","gross"],"type":"string"},"currency":{"enum":["CNY"],"type":"string"}},"required":["currency","amount_minor","basis"],"type":"object"},"action":{"type":"string","enum":["clarification","counter_offer"]}},"required":["task_id","candidate_id","expected_offer_digest","comparison_ref","request_id","action"],"additionalProperties":false},"name":"kiwi_negotiate"},{"description":"Confirm and accept a non-binding agreement. Requires a valid approval_id + candidate_id; outputs a stable agreement_id. When DelegationPolicy=ask and approval is missing, returns approval_required (with a persistent approval_id); retry with that approval_id once the host completes human approval.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approval_id":{"minLength":1,"type":"string"},"candidate_id":{"minLength":1,"type":"string"},"task_id":{"minLength":1,"type":"string"}},"required":["task_id","candidate_id"],"type":"object"},"name":"kiwi_accept_agreement"},{"description":"Read the final agreement, provenance, and audit summary. Read-only; agreement retrieval + digest + audit summary.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"agreement_id":{"minLength":1,"type":"string"}},"required":["agreement_id"],"type":"object"},"name":"kiwi_get_agreement"},{"description":"Produce the transaction / PO / contact path. Agreement -> UCP Checkout / merchant transaction endpoint. Valid destination_type values: ucp_checkout | ucp_order | external_checkout_url | merchant_checkout_session | platform_deep_link | buyer_erp_request | procurement_request | purchase_order_draft | quote_document | merchant_contact | sales_handoff. external_checkout_url and platform_deep_link require a url (use external_checkout_url + the merchant's handoff URL for a storefront checkout page); ucp_checkout / ucp_order / merchant_checkout_session are opaque session refs and must not carry url. When ASK and approval is missing, returns structured approval_required (with approval_id); host runs kiwi_approve then retries with the id.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"agreement_id":{"minLength":1,"type":"string"},"approval_id":{"minLength":1,"type":"string"},"destination_type":{"minLength":1,"type":"string"},"url":{"type":"string"}},"required":["agreement_id","destination_type"],"type":"object"},"name":"kiwi_handoff"},{"description":"Approve a persistent approval (ASK gate). Call after the host presents the non-binding agreement / handoff summary to the user and obtains consent; then retry kiwi_accept_agreement / kiwi_handoff with the approval_id. Write op, double-gated by the host's approval system.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approval_id":{"minLength":1,"type":"string"},"note":{"type":"string"}},"required":["approval_id"],"type":"object"},"name":"kiwi_approve"},{"description":"Reject a persistent approval (deny is the preferred path). Once rejected, the same approval_id can no longer be approved or produce an agreement/handoff.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approval_id":{"minLength":1,"type":"string"},"reason":{"type":"string"}},"required":["approval_id"],"type":"object"},"name":"kiwi_reject"},{"description":"Explicitly follow a merchant (pull-based subscription). Buyer-initiated only: searching, browsing, viewing a profile, or requesting quotes never constitutes a subscription and must not replace the buyer's explicit follow. After following, the buyer can use kiwi_get_follow_updates to check the merchant's public updates on demand; merchants cannot push messages to followers. Requires Kiwi catalog sign-in (returns a sign-in guide when not configured).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"category":{"description":"Optional: only care about public updates in this category","type":"string"},"consent_version":{"description":"Optional: the version of the subscription terms the buyer consented to","type":"string"},"merchant_id":{"minLength":1,"type":"string"}},"required":["merchant_id"],"type":"object"},"name":"kiwi_follow_merchant"},{"description":"Unfollow a merchant (idempotent). Buyer-initiated only; after unfollowing, the merchant leaves the follow list and its public updates are no longer shown.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"merchant_id":{"minLength":1,"type":"string"}},"required":["merchant_id"],"type":"object"},"name":"kiwi_unfollow_merchant"},{"description":"List the buyer's currently followed merchants (follow management surface). Read-only; requires Kiwi catalog sign-in (returns a sign-in guide when not configured).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{},"type":"object"},"name":"kiwi_list_follows"},{"description":"Check public updates from followed merchants. Call only in response to an explicit buyer ask (e.g. 'any new updates from merchants I follow?'): returns the merchants' public updates incrementally by watermark (product_added / product_updated / faq_updated / service_notice / publication_withdrawn, public fields only), acknowledge processed groups on the next call using watermarks (merchant_id to last_seen_at). Pull-based subscription: merchants cannot push messages to the buyer, and this tool never receives merchant DMs on the buyer's behalf.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"watermarks":{"type":"object","maxProperties":500,"additionalProperties":{"type":"string"}}},"type":"object"},"name":"kiwi_get_follow_updates"},{"description":"Create or revise a procurement case, attach evidence, or record an external decision.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"lines":{"items":{"additionalProperties":false,"properties":{"input_line_id":{"maxLength":256,"minLength":1,"type":"string"},"raw":{"maxLength":2000,"minLength":1,"type":"string"}},"required":["input_line_id","raw"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"},"request_id":{"maxLength":256,"minLength":1,"type":"string"},"basis":{"additionalProperties":false,"properties":{"budget":{"additionalProperties":false,"properties":{"amount_minor":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"hardness":{"enum":["hard","soft"],"type":"string"},"scope":{"enum":["total","unit"],"type":"string"}},"required":["amount_minor","hardness","scope"],"type":"object"},"buyer_item_key":{