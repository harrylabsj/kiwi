{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haina:freight:charge-group-input:0.1.0",
  "title": "charge-group-input",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "carrier_id": {
      "type": "string",
      "minLength": 1
    },
    "trip_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "service_leg_id": {
      "type": "string",
      "minLength": 1
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_class": {
      "type": "string",
      "minLength": 1
    },
    "charge_code": {
      "type": "string",
      "enum": [
        "BASE",
        "WAIT",
        "TOLL"
      ]
    },
    "service_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "currency": {
      "const": "CNY"
    },
    "amount_basis": {
      "type": "string",
      "enum": [
        "GROSS",
        "NET",
        "UNKNOWN"
      ]
    },
    "match_state": {
      "type": "string",
      "enum": [
        "EXACT",
        "CONFIRMED",
        "UNMATCHED",
        "AMBIGUOUS",
        "CONFLICT"
      ]
    },
    "trip_status": {
      "type": "string",
      "enum": [
        "EXECUTED",
        "CANCELLED",
        "UNKNOWN"
      ]
    },
    "pod_state": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "MISSING",
        "CONFLICT",
        "NOT_REQUIRED"
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "elapsed_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 31536000
            },
            {
              "type": "null"
            }
          ]
        },
        "time_evidence_verified": {
          "type": "boolean"
        },
        "receipt_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_verified": {
          "type": "boolean"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "elapsed_seconds",
        "time_evidence_verified",
        "receipt_minor",
        "receipt_verified",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "bill_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "amount_minor": {
            "type": "integer",
            "minimum": -1000000000000,
            "maximum": 1000000000000
          },
          "reversal_of": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "line_id",
          "amount_minor",
          "reversal_of",
          "source_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RateRule"
      },
      "minItems": 0
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "group_id",
    "workspace_id",
    "carrier_id",
    "trip_id",
    "service_leg_id",
    "occurrence_id",
    "route_id",
    "vehicle_class",
    "charge_code",
    "service_time",
    "currency",
    "amount_basis",
    "match_state",
    "trip_status",
    "pod_state",
    "event",
    "bill_lines",
    "rules",
    "source_refs"
  ],
  "additionalProperties": false,
  "$defs": {
    "RateRule": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "carrier_id": {
          "type": "string",
          "minLength": 1
        },
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "vehicle_class": {
          "type": "string",
          "minLength": 1
        },
        "charge_code": {
          "type": "string",
          "enum": [
            "BASE",
            "WAIT",
            "TOLL"
          ]
        },
        "currency": {
          "const": "CNY"
        },
        "amount_basis": {
          "type": "string",
          "enum": [
            "GROSS",
            "NET"
          ]
        },
        "effective_from": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "effective_to": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "formula": {
          "type": "string",
          "enum": [
            "PER_TRIP",
            "WAIT_BLOCKS",
            "ACTUAL_RECEIPT"
          ]
        },
        "rate_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "free_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "block_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "cap_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed": {
          "type": "boolean"
        },
        "confirmation_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "rule_id",
        "version",
        "workspace_id",
        "carrier_id",
        "route_id",
        "vehicle_class",
        "charge_code",
        "currency",
        "amount_basis",
        "effective_from",
        "effective_to",
        "formula",
        "rate_minor",
        "free_seconds",
        "block_seconds",
        "cap_minor",
        "confirmed",
        "confirmation_ref",
        "source_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "confirmation_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
