{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haina:freight:review-decision:0.1.0",
  "title": "review-decision",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "CONFIRMED_DIFFERENCE",
        "ACCEPTED_AS_BILLED",
        "NEEDS_EVIDENCE",
        "DISPUTED",
        "OUT_OF_SCOPE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PREPARED",
        "CONFIRMED",
        "STALE"
      ]
    },
    "confirmed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmation_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "workspace_id",
    "run_id",
    "group_id",
    "result_digest",
    "actor_id",
    "decision",
    "reason",
    "source_refs",
    "status",
    "confirmed_at",
    "confirmation_ref"
  ],
  "additionalProperties": false
}
