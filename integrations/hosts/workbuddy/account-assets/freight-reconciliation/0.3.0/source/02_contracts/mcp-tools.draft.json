                    "INTEGER",
                    "MONEY_YUAN",
                    "MONEY_MINOR",
                    "DATETIME",
                    "ENUM"
                  ]
                },
                "unit": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "amount_basis": {
                  "type": "string",
                  "enum": [
                    "GROSS",
                    "NET",
                    "UNKNOWN",
                    "NOT_APPLICABLE"
                  ]
                },
                "source_timezone": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "source_column",
                "target_field",
                "data_type",
                "unit",
                "amount_basis",
                "source_timezone"
              ],
              "additionalProperties": false
