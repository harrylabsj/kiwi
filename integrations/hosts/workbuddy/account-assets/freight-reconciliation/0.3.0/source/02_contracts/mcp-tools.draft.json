    {
      "name": "freight_prepare_rate_rules",
      "description": "candidate_id / conflicts / confirmation_entry",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "route_id": {
                  "type": "string",
                  "minLength": 1
                },
                "vehicle_class": {
                  "type": "string",
                  "minLength": 1
                },
                "charge_code": {
                  "type": "string",
                  "enum": [
                    "BASE",
                    "WAIT",
                    "TOLL"
                  ]
                },
                "currency": {
                  "const": "CNY"
                },
                "amount_basis": {
                  "type": "string",
                  "enum": [
                    "GROSS",
                    "NET"
                  ]
                },
                "effective_from": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "effective_to": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "formula": {
                  "type": "string",
                  "enum": [
                    "PER_TRIP",
                    "WAIT_BLOCKS",
                    "ACTUAL_RECEIPT"
                  ]
                },
                "rate_minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "free_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31536000
                },
                "block_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31536000
                },
                "cap_minor": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "route_id",
                "vehicle_class",
                "charge_code",
                "currency",
                "amount_basis",
                "effective_from",
                "effective_to",
                "formula",
                "rate_minor",
                "free_seconds",
                "block_seconds",
                "cap_minor",
                "source_refs"
              ],
              "additionalProperties": false
            }
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case_id",
          "expected_revision",
          "rules",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
