{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haina:freight:export-manifest:0.1.0",
  "title": "export-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "projection": {
      "type": "string",
      "enum": [
        "INTERNAL_FULL",
        "CARRIER_REDACTED"
      ]
    },
    "purpose": {
      "type": "string",
      "enum": [
        "INTERNAL_REVIEW",
        "CARRIER_CHECK"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PREPARED",
        "RELEASED",
        "DOWNLOADED"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "confirmation_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "unresolved_group_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "mime_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "filename",
          "sha256",
          "byte_size",
          "mime_type"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "schema_version",
    "export_id",
    "workspace_id",
    "run_id",
    "input_digest",
    "projection",
    "purpose",
    "status",
    "actor_id",
    "confirmation_ref",
    "unresolved_group_count",
    "coverage_note",
    "artifacts",
    "created_at"
  ],
  "additionalProperties": false
}
