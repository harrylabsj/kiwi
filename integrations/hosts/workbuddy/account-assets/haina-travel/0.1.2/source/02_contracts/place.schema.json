{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/haina-travel/0.1.0/place.schema.json",
  "title": "place",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "provider_place_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "ATTRACTION",
        "RESTAURANT",
        "HOTEL",
        "TRANSPORT",
        "OTHER"
      ]
    },
    "coordinate_system": {
      "enum": [
        "GCJ02",
        "WGS84",
        "SYNTHETIC"
      ]
    },
    "lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "identity_evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "provider",
    "provider_place_id",
    "name",
    "city",
    "address",
    "category",
    "coordinate_system",
    "lng",
    "lat",
    "identity_evidence_id",
    "tags"
  ],
  "additionalProperties": false
}
