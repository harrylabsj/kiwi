{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/haina-travel/0.1.0/evidence.schema.json",
  "title": "evidence",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "IDENTITY",
        "OPENING",
        "RESERVATION",
        "ROOM_POLICY",
        "PRICE",
        "WEATHER",
        "ROUTE",
        "BOOKING",
        "OTHER"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "OFFICIAL",
        "OPERATOR",
        "MAP_PROVIDER",
        "AUTHORIZED_PLATFORM",
        "USER",
        "SYNTHETIC"
      ]
    },
    "source_uri": {
      "type": "string",
      "format": "uri"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "date_specific": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "VERIFIED",
        "ESTIMATED",
        "UNCONFIRMED",
        "CONFLICTING"
      ]
    },
    "provenance_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "subject_id",
    "claim_type",
    "claim",
    "source_type",
    "source_uri",
    "retrieved_at",
    "expires_at",
    "valid_from",
    "valid_until",
    "date_specific",
    "status",
    "provenance_ref"
  ],
  "additionalProperties": false
}
