{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/haina-travel/0.1.0/itinerary.schema.json",
  "title": "itinerary",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trip_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "data_origin": {
      "enum": [
        "SYNTHETIC",
        "LIVE"
      ]
    },
    "planning_status": {
      "enum": [
        "DRAFT",
        "CONDITIONAL",
        "CHECKED",
        "ACCEPTED",
        "NEEDS_REPLAN",
        "ARCHIVED"
      ]
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "$ref": "https://schemas.example.invalid/haina-travel/0.1.0/trip_request.schema.json"
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.invalid/haina-travel/0.1.0/place.schema.json"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.example.invalid/haina-travel/0.1.0/evidence.schema.json"
      },
      "minItems": 1
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "place_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "ATTRACTION",
                    "MEAL",
                    "REST",
                    "ARRIVAL",
                    "DEPARTURE",
                    "FREE_TIME"
                  ]
                },
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                },
                "locked": {
                  "type": "boolean"
                },
                "priority": {
                  "enum": [
                    "MUST",
                    "PREFERRED",
                    "OPTIONAL"
                  ]
                },
                "availability": {
                  "enum": [
                    "OPEN",
                    "CLOSED",
                    "UNKNOWN"
                  ]
                },
                "open_from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "open_until": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "opening_evidence_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reservation_status": {
                  "enum": [
                    "NOT_REQUIRED",
                    "NOT_BOOKED",
                    "USER_REPORTED",
                    "CONFIRMED",
                    "SOLD_OUT",
                    "UNKNOWN"
                  ]
                },
                "booking_evidence_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reservation_evidence_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "indoor_walk_m": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "highlight": {
                  "type": "string"
                },
                "fallback_slot_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "place_id",
                "kind",
                "start",
                "end",
                "locked",
                "priority",
                "availability",
                "open_from",
                "open_until",
                "opening_evidence_id",
                "reservation_status",
                "booking_evidence_id",
                "reservation_evidence_id",
                "indoor_walk_m",
                "rationale",
                "highlight",
                "fallback_slot_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "daily_walk_m": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "date",
          "slots",
          "daily_walk_m"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "place_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "ATTRACTION",
              "MEAL",
              "REST",
              "ARRIVAL",
              "DEPARTURE",
              "FREE_TIME"
            ]
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "locked": {
            "type": "boolean"
          },
          "priority": {
            "enum": [
              "MUST",
              "PREFERRED",
              "OPTIONAL"
            ]
          },
          "availability": {
            "enum": [
              "OPEN",
              "CLOSED",
              "UNKNOWN"
            ]
          },
          "open_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "open_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "opening_evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reservation_status": {
            "enum": [
              "NOT_REQUIRED",
              "NOT_BOOKED",
              "USER_REPORTED",
              "CONFIRMED",
              "SOLD_OUT",
              "UNKNOWN"
            ]
          },
          "booking_evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reservation_evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "indoor_walk_m": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "highlight": {
            "type": "string"
          },
          "fallback_slot_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "place_id",
          "kind",
          "start",
          "end",
          "locked",
          "priority",
          "availability",
          "open_from",
          "open_until",
          "opening_evidence_id",
          "reservation_status",
          "booking_evidence_id",
          "reservation_evidence_id",
          "indoor_walk_m",
          "rationale",
          "highlight",
          "fallback_slot_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from_slot_id": {
            "type": "string",
            "minLength": 1
          },
          "to_slot_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "WALK",
              "TRANSIT",
              "DRIVE",
              "TAXI",
              "OTHER"
            ]
          },
          "duration_low_min": {
            "type": "integer",
            "minimum": 0
          },
          "duration_high_min": {
            "type": "integer",
            "minimum": 0
          },
          "buffer_min": {
            "type": "integer",
            "minimum": 0
          },
          "walk_m": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimate_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "from_slot_id",
          "to_slot_id",
          "mode",
          "duration_low_min",
          "duration_high_min",
          "buffer_min",
          "walk_m",
          "evidence_id",
          "estimate_basis"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "lodgings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "place_id": {
            "type": "string",
            "minLength": 1
          },
          "check_in_date": {
            "type": "string",
            "format": "date"
          },
          "check_out_date": {
            "type": "string",
            "format": "date"
          },
          "rooms": {
            "type": "integer",
            "minimum": 1
          },
          "capacity_per_room": {
            "type": "integer",
            "minimum": 1
          },
          "policy_evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "booking_status": {
            "enum": [
              "NOT_BOOKED",
              "USER_REPORTED",
              "CONFIRMED",
              "UNKNOWN"
            ]
          },
          "booking_evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "locked": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "place_id",
          "check_in_date",
          "check_out_date",
          "rooms",
          "capacity_per_room",
          "policy_evidence_id",
          "booking_status",
          "booking_evidence_id",
          "locked",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "const": "CNY"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": [
                  "INTERCITY",
                  "LODGING",
                  "MEALS",
                  "LOCAL_TRANSPORT",
                  "TICKETS",
                  "OTHER",
                  "RESERVE"
                ]
              },
              "subject_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "unit": {
                "enum": [
                  "PARTY",
                  "PERSON",
                  "ROOM_NIGHT",
                  "VEHICLE",
                  "ITEM"
                ]
              },
              "unit_low_fen": {
                "type": "integer",
                "minimum": 0
              },
              "unit_high_fen": {
                "type": "integer",
                "minimum": 0
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "amount_low_fen": {
                "type": "integer",
                "minimum": 0
              },
              "amount_high_fen": {
                "type": "integer",
                "minimum": 0
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "status": {
                "enum": [
                  "PAID_USER_REPORTED",
                  "QUOTE",
                  "ESTIMATE"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "category",
              "subject_ids",
              "unit",
              "unit_low_fen",
              "unit_high_fen",
              "quantity",
              "amount_low_fen",
              "amount_high_fen",
              "evidence_ids",
              "status",
              "notes"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "total_low_fen": {
          "type": "integer",
          "minimum": 0
        },
        "total_high_fen": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "currency",
        "items",
        "total_low_fen",
        "total_high_fen",
        "excluded_categories"
      ],
      "additionalProperties": false
    },
    "pending_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "change_summary": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trip_id",
    "version",
    "data_origin",
    "planning_status",
    "theme",
    "request",
    "places",
    "evidence",
    "days",
    "alternatives",
    "legs",
    "lodgings",
    "budget",
    "pending_actions",
    "change_summary"
  ],
  "additionalProperties": false
}
