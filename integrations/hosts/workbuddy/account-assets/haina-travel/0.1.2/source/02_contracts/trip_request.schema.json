{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/haina-travel/0.1.0/trip_request.schema.json",
  "title": "trip_request",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trip_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "party_size": {
      "type": "integer",
      "minimum": 1
    },
    "budget_cap_fen": {
      "type": "integer",
      "minimum": 0
    },
    "budget_scope": {
      "enum": [
        "ALL_IN",
        "DESTINATION_ONLY"
      ]
    },
    "max_daily_walk_m": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_continuous_walk_m": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "hard_exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "consent_to_store": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "trip_id",
    "origin",
    "destination",
    "timezone",
    "start_date",
    "end_date",
    "party_size",
    "budget_cap_fen",
    "budget_scope",
    "max_daily_walk_m",
    "max_continuous_walk_m",
    "interests",
    "hard_exclusions",
    "assumptions",
    "consent_to_store"
  ],
  "additionalProperties": false
}
