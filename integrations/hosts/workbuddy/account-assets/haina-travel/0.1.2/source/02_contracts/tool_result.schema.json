{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/haina-travel/0.1.0/tool_result.schema.json",
  "title": "tool_result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "enum": [
        "PLACE_SEARCH",
        "PLACE_DETAIL",
        "ROUTE",
        "WEB_READ",
        "WEATHER",
        "MAP_EXPORT"
      ]
    },
    "status": {
      "enum": [
        "OK",
        "PARTIAL",
        "UNAVAILABLE",
        "RATE_LIMITED",
        "UNSUPPORTED",
        "DENIED"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "cost_microunits": {
      "type": "integer",
      "minimum": 0
    },
    "billing_currency": {
      "type": "string",
      "minLength": 1
    },
    "provider_trace_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "tool",
    "status",
    "retrieved_at",
    "data",
    "evidence_ids",
    "error_code",
    "retryable",
    "cost_microunits",
    "billing_currency",
    "provider_trace_id"
  ],
  "additionalProperties": false
}
