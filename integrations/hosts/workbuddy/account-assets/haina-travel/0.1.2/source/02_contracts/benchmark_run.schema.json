{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/haina-travel/0.1.0/benchmark_run.schema.json",
  "title": "benchmark_run",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "E"
      ]
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "host_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_active_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "critical_errors": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "task_completed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "adopted_in_real_trip": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer_notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "arm",
    "status",
    "model_id",
    "host_version",
    "prompt_hash",
    "snapshot_id",
    "seed_label",
    "human_active_seconds",
    "critical_errors",
    "task_completed",
    "adopted_in_real_trip",
    "artifact_path",
    "reviewer_notes"
  ],
  "additionalProperties": false
}
