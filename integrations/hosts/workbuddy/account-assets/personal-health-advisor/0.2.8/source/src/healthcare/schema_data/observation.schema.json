{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harrylabsj/healthcare/schemas/observation.schema.json",
  "title": "Observation",
  "description": "A confirmed observation in the Phase 1A0 formal projection. Only fields whose identity is confirmed and that a user confirmed in trusted local Control may appear here. Never a diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "person_id", "field", "value", "measured_at", "document_id", "evidence_id", "provenance_id", "verification_status", "revision", "mapping_status", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "person_id": { "type": "string", "minLength": 1 },
    "field": { "type": "string", "minLength": 1 },
    "value": { "type": "number" },
    "unit": { "type": ["string", "null"], "minLength": 1 },
    "measured_at": { "type": "string", "format": "date" },
    "document_id": { "type": "string", "minLength": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "provenance_id": { "type": "string", "minLength": 1 },
    "raw_value": { "type": ["string", "null"] },
    "raw_unit": { "type": ["string", "null"] },
    "reference_range_original": { "type": ["string", "null"] },
    "raw_comparator": { "type": ["string", "null"] },
    "verification_status": { "type": "string", "enum": ["candidate", "machine_validated", "user_confirmed", "professional_confirmed"] },
    "revision": { "type": "integer", "minimum": 1 },
    "value_type": { "type": "string", "enum": ["numeric", "text", "code", "boolean", "ratio", "range"] },
    "text_value": { "type": ["string", "null"] },
    "mapping_status": { "type": "string", "enum": ["mapped", "unmapped", "ambiguous"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
