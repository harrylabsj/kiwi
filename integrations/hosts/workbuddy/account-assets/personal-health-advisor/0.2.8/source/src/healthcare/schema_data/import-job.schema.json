{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harrylabsj/healthcare/schemas/import-job.schema.json",
  "title": "ImportJob",
  "description": "The application-level source of truth for one import pipeline (RFC 16.3). The MCP Tasks projection, when present, is derived from this and never overrides it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "document_id", "status", "candidate_ids", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "person_id": { "type": ["string", "null"], "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["awaiting_identity", "awaiting_review", "partially_committed", "committed", "failed", "cancelled", "expired"] },
    "candidate_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "state": { "type": ["string", "null"] },
    "idempotency_key": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "error": { "type": ["string", "null"] },
    "confirmation_receipt_id": { "type": ["string", "null"] }
  }
}
