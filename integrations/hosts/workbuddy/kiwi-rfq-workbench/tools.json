{
  "schema_version": "0.1.0",
  "artifact_kind": "MCP_TOOL_DESIGN_NOT_WORKBUDDY_MANIFEST",
  "notes": [
    "权限标记是本方案概念，不是已配置的平台scope。",
    "工具输入不承载可信merchant/principal；由已验证上下文注入。",
    "annotations只是提示，授权由服务端执行。",
    "正式outputSchema及SDK注册代码在RFQ-012实现；此文件不宣称能直接安装。"
  ],
  "tools": [
    {
      "name": "kiwi_merchant_rfq_ingest",
      "description": "导入未信任文本/CSV形成未确认需求；不会发布或发送。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "manual_text",
                  "csv"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000000
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "kind",
              "text",
              "label"
            ]
          },
          "client_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "source",
          "client_ref",
          "idempotency_key"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "design_authorization": "merchant:workflow_prepare",
      "design_status": "PROPOSED_NOT_REGISTERED"
    },
    {
      "name": "kiwi_merchant_rfq_get",
      "description": "读取当前需求、版本与阻断项。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "case_id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "design_authorization": "merchant:read",
      "design_status": "PROPOSED_NOT_REGISTERED"
    },
    {
      "name": "kiwi_merchant_rfq_revise",
      "description": "提交字段修订建议；涉及关键字段时清除旧确认并增加版本。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field_path": {
                  "type": "string",
                  "enum": [
                    "query",
                    "quantity",
                    "unit",
                    "recipient_ref",
                    "tax_basis",
                    "tax_rate_bps",
                    "shipping_minor",
                    "delivery_terms",
                    "payment_terms"
                  ]
                },
                "line_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "proposed_value": {
                  "type": [
                    "string",
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "field_path",
                "proposed_value"
              ]
            }
          }
        },
        "required": [
          "case_id",
          "expected_revision",
          "idempotency_key",
          "changes"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "design_authorization": "merchant:workflow_prepare",
      "design_status": "PROPOSED_NOT_REGISTERED"
    },
    {
      "name": "kiwi_merchant_rfq_close",
      "description": "操作者显式取消或关闭询盘 case；未决审批候选一并失效（APPROVAL_STALE），不删除既有审计与已导出版本。终态后拒绝新的计价、发布与确认请求。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "CANCELLED",
              "CLOSED"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ]
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "case_id",
          "expected_revision",
          "outcome",
          "idempotency_key"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "design_authorization": "merchant:workflow_prepare",
      "design_status": "PROPOSED_NOT_REGISTERED"
    },
