{
  "name": "@harrylabsj/kiwi-dsh-plugin",
  "version": "0.1.0",
  "description": "Kiwi Buyer plugin for DeepSeek Harness — kiwi-buyer-mcp as an MCP plugin + kiwi-buyer skill. Install: dsh plugin --profile web add @harrylabsj/kiwi-dsh-plugin",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-mcp-client": "^0.1.0-rc.7"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "prepack": "npm run validate"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "kiwi",
    "commerce",
    "sourcing",
    "rfq",
    "negotiation"
  ],
  "license": "Apache-2.0",
  "author": "harrylabsj"
}
